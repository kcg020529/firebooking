# 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env.local 은 .gitignore 에 있으므로 커밋되지 않는다.
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 그대로 노출된다.
#    anon 키는 붙여도 되고, service_role 키와 API 키는 절대 안 된다.

# Supabase — 대시보드 Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Turnstile 사이트키 — 브라우저에 노출되는 공개용 값이라 NEXT_PUBLIC_ 이 맞다.
# 시크릿키는 여기 두지 않는다. Supabase Dashboard > Authentication > Attack Protection 에만 넣는다.
# 비워두면 CAPTCHA 위젯을 그리지 않는다. Supabase CAPTCHA 를 켜기 전에 이 값부터 배포한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 서버 전용 — 이 키는 RLS를 우회한다. 클라이언트 코드에서 import 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# DeepSeek API — platform.deepseek.com 에서 발급. 실제 값은 .env.local 에만 입력한다.
DEEPSEEK_API_KEY=

# 보안 HMAC용 비밀값 — 32바이트 이상의 랜덤 문자열. 팀 환경에서 같은 값을 쓴다.
# IP·로그인 식별자 가명화와 세션 타임아웃 서명에 쓰므로 서버에만 둔다.
IP_HASH_SALT=change-me-to-random-string

# 서버 전용 — Discord 긴급 보안 알림 Webhook URL. critical 이벤트 발생 시 실시간 전송.
# 실제 Webhook URL은 .env.local 및 Vercel 환경 변수에만 등록한다. (NEXT_PUBLIC_ 사용 금지)
DISCORD_SECURITY_WEBHOOK_URL=

# 서버 전용 — critical 사고 IP 암호화용 AES-256 키(Base64 인코딩된 32바이트).
# 예: openssl rand -base64 32
# IP_HASH_SALT와 다른 값을 사용하고, Vercel Production/Preview에 각각 안전하게 등록한다.
SECURITY_IP_ENCRYPTION_KEY=

# 서버 전용 — Cloudflare 프록시 경유 검증용 비밀값(32바이트 hex 권장).
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cloudflare Request Header Transform Rule이 x-firebooking-origin 헤더에 같은 값을 Set static으로 붙인다.
# 값이 없으면 cf-connecting-ip·cf-ipcountry를 신뢰하지 않고 Vercel이 본 접속 IP를 쓴다.
CLOUDFLARE_ORIGIN_SECRET=
